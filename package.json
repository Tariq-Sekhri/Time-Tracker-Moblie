{
  "name": "time-tracker-mobile",
  "private": true,
  "version": "0.5.3",
  "scripts": {
    "bump": "node scripts/bump.mjs",
    "tauri": "tauri",
    "build:ui": "npm --prefix \"../time tracker\" run build:mobile",
    "check": "npm --prefix \"../time tracker\" run check:mobile",
    "android:dev": "node scripts/android.mjs dev",
    "android:build": "node scripts/android.mjs build",
    "android:apk": "node scripts/android.mjs build --debug --target aarch64 --apk",
    "android:qa": "node scripts/android.mjs build --debug --target x86_64 --apk",
    "android:release": "node scripts/android.mjs build --target aarch64 --aab",
    "android:check": "node scripts/android.mjs check"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0"
  }
}
