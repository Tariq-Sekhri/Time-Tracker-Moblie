{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Time Tracker",
  "version": "0.5.3",
  "identifier": "ca.tariq-sekhri.time-tracker",
  "build": {
    "beforeDevCommand": "npm --prefix \"../time tracker\" run dev:mobile",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../../time tracker/dist-mobile"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Time Tracker"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "android": {
      "minSdkVersion": 33,
      "versionCode": 10,
      "debugApplicationIdSuffix": ".dev"
    }
  }
}
